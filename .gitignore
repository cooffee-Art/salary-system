# ============================================================
# 员工薪资管理系统（Console Edition） .gitignore
# ============================================================

# ---------- Java 编译产物 ----------
out/
target/
test-out/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# 保留 lib 目录占位文件；JDBC 驱动 JAR 由开发者自行放入，不提交
!lib/.gitkeep

# 防止误提交前端残留依赖
node_modules/
dist/

# ---------- IntelliJ IDEA ----------
.idea/
*.iml
*.iws
*.ipr
*.hprof

# ---------- VS Code ----------
.vscode/

# ---------- 本地环境与密钥 ----------
.env
.env.*
!.env.example
*.log
logs/

# ---------- 本地跑测临时目录 ----------
_run/

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini
